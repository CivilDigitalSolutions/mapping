{
  "name": "data-mapper",
  "private": true,
  "version": "1.0.0",
  "description": "Progressive web app for overlaying CSV / pasted coordinate data on a map.",
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 8080",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "node --test --test-concurrency=2 tests/e2e/*.test.mjs",
    "test:all": "npm test && npm run test:e2e"
  },
  "devDependencies": {
    "axe-core": "4.10.2",
    "playwright": "1.63.0"
  }
}
